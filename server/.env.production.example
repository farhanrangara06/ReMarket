# Production environment — copy to .env on your hosting platform (Render, Railway, etc.)
# NEVER commit real production secrets to git

NODE_ENV=production
PORT=5000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/remarket?retryWrites=true&w=majority

# Strong random secrets — minimum 32 characters each
JWT_SECRET=replace_with_long_random_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_different_long_random_secret_min_32_chars
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Frontend URL(s) — comma-separated for multiple domains
CLIENT_URL=https://yourdomain.com,https://www.yourdomain.com

# Cookie settings (use "none" when frontend and API are on different domains)
COOKIE_SAME_SITE=none

# Cloudinary (Phase 3)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Email (Phase 4 — required in production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@yourdomain.com

# Razorpay (Phase 6)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
