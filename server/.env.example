PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/remarket
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_key_for_phase_2
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Production template: see .env.production.example

# Cloudinary (Phase 3 — production image hosting)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Email (Phase 4 — leave unset for dev auto-verify)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@remarket.local

# Razorpay (Phase 6)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
